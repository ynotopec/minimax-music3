# ── MiniMax API (Cloud mode) ──────────────────────────────────────────
# Option A: MiniMax Cloud API (requires an account)
MINIMAX_API_KEY=your-minimax-api-key
MINIMAX_API_URL=https://api.minimaxi.com/v1

# ── SGLang-Omni (Local mode — recommended if you have GPU) ───────────
# Set SGLANG_HOST/SGLANG_PORT and leave MINIMAX_API_KEY empty for local mode.
SGLANG_HOST=127.0.0.1
SGLANG_PORT=8000

# ── Server Configuration ──────────────────────────────────────────────
HOST=0.0.0.0
PORT=8643

# ── GPU Configuration (optional) ─────────────────────────────────────
# USE_GPU=0
# CUDA_DEVICE=0
